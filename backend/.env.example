# ============================================================
# AgendixPOS - Backend
# Copiar este archivo como .env y completar los valores reales.
# NUNCA subir el archivo .env al repositorio.
# ============================================================

# --- MongoDB ---
# Cadena de conexión de MongoDB Atlas o de un MongoDB propio.
# Formato Atlas: mongodb+srv://<usuario>:<contraseña>@<cluster>/?retryWrites=true&w=majority
MONGODB_URL=
MONGODB_DATABASE=agendixpos

# --- Autenticación (JWT) ---
# Clave secreta para firmar los tokens (mínimo 32 caracteres). Generar una con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---
# Orígenes del frontend permitidos, separados por coma.
CORS_ORIGINS=http://localhost:5173
